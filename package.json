{
  "name": "campus-sell-buy-portal",
  "version": "1.0.0",
  "description": "Campus Sell & Buy Portal - College-focused second-hand marketplace",
  "private": true,
  "scripts": {
    "start": "npm --prefix server start",
    "server": "npm --prefix server run dev",
